[gd_resource type="Resource" script_class="QuestDefinition" format=3 uid="uid://b4b55pwh1d36"]

[ext_resource type="Script" uid="uid://bc3lf2fxs1rr4" path="res://src/quests/quest_definition.gd" id="1_quest"]
[ext_resource type="Script" uid="uid://dneosmrbxu6np" path="res://src/quests/quest_objective.gd" id="2_obj"]

[sub_resource type="Resource" id="Resource_completion"]
script = ExtResource("2_obj")
description = "Riporta i quattro pegni al fan in attesa"
dialogic_variable = "TokenQuestStatus"
required_value = 3

[sub_resource type="Resource" id="Resource_warrior"]
script = ExtResource("2_obj")
description = "Trova il Guerriero"
dialogic_variable = "HasWarriorToken"

[sub_resource type="Resource" id="Resource_thief"]
script = ExtResource("2_obj")
description = "Trova il Ladro"
dialogic_variable = "HasThiefToken"

[sub_resource type="Resource" id="Resource_monk"]
script = ExtResource("2_obj")
description = "Trova il Monaco"
dialogic_variable = "HasMonkToken"

[sub_resource type="Resource" id="Resource_wizard"]
script = ExtResource("2_obj")
description = "Trova il Mago"
dialogic_variable = "HasWizardToken"

[resource]
script = ExtResource("1_quest")
id = &"fan_of_four"
title = "La Banda dei Quattro"
objectives = Array[ExtResource("2_obj")]([SubResource("Resource_warrior"), SubResource("Resource_thief"), SubResource("Resource_monk"), SubResource("Resource_wizard")])
completion_objective = SubResource("Resource_completion")
