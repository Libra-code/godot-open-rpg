[gd_resource type="Resource" script_class="QuestDefinition" format=3]

[ext_resource type="Script" path="res://src/quests/quest_definition.gd" id="1_quest"]
[ext_resource type="Script" path="res://src/quests/quest_objective.gd" id="2_obj"]

[sub_resource type="Resource" id="Resource_completion"]
script = ExtResource("2_obj")
description = "Risveglia il Nucleo della tua Anima al piedistallo"
dialogic_variable = "SoulCoreAwakened"

[sub_resource type="Resource" id="Resource_wizard_trust"]
script = ExtResource("2_obj")
description = "Guadagna la fiducia del Mago"
dialogic_variable = "HasWizardToken"

[sub_resource type="Resource" id="Resource_tree"]
script = ExtResource("2_obj")
description = "Scopri il segreto dell'Albero Strano"
dialogic_variable = "StrangeTreeExamined"

[resource]
script = ExtResource("1_quest")
id = &"soul_awakening"
title = "Il Nucleo Dormiente"
objectives = Array[ExtResource("2_obj")]([SubResource("Resource_wizard_trust"), SubResource("Resource_tree")])
completion_objective = SubResource("Resource_completion")
